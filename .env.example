# Rename this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub — add it to .gitignore.

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=*****
DB_NAME=counterguard_db
# Only needed when connecting to a managed MySQL host that requires TLS
# (e.g. Aiven) — leave blank for local development.
DB_SSL_CA=

# File uploads
MAX_CONTENT_LENGTH_MB=5
UPLOAD_FOLDER=static/uploads
BARCODE_FOLDER=static/barcodes

# Admin bootstrap (used only by the seed script to create the first admin)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@counterguard.local
DEFAULT_ADMIN_PASSWORD=Admin@12345